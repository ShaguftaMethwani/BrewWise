# Database (PostgreSQL for Docker, SQLite supported for local dev)
DATABASE_URL=postgresql+asyncpg://brewwise:password@localhost:5432/brewwise
# Local dev alternative: sqlite+aiosqlite:///./brewwise.db

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO or S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=brewwise-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# AI Providers
VISION_PROVIDER=gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
GOOGLE_API_KEY=your_gemini_api_key_here

# Application Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
