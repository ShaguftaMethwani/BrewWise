# Database: SQLite works out of the box for local development.
# Docker Compose sets its own PostgreSQL URL, so this value is not used there.
DATABASE_URL=sqlite+aiosqlite:///./brewwise.db
# PostgreSQL alternative: postgresql+asyncpg://brewwise:password@localhost:5432/brewwise

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO or S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=brewwise-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# AI Providers
# Set VISION_PROVIDER=mock only for offline UI demos: it returns one fixed sample profile for every image
VISION_PROVIDER=gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=your_gemini_api_key_here

# Live Web Discovery (runs on every scan unless the knowledge base already has an exact match)
# SEARCH_PROVIDER: tavily | google | none. With "none" (or a missing key) the app says so in the UI
# and uses the local knowledge base only - it never simulates search results.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
# For SEARCH_PROVIDER=google (Programmable Search): SEARCH_API_KEY + GOOGLE_SEARCH_CX
SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
LIVE_DISCOVERY_ENABLED=true
LIVE_DISCOVERY_PERSIST=true
LIVE_DISCOVERY_TOTAL_TIMEOUT=15
LIVE_DISCOVERY_PER_URL_TIMEOUT=6
LIVE_DISCOVERY_MAX_URLS=5
LIVE_DISCOVERY_RATE_LIMIT=10

# Application Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
